{
  "mcpServers": {
    "dataforseo": {
      "command": "npx",
      "args": ["-y", "dataforseo-mcp-server@3.1.3"],
      "env": {
        "DATAFORSEO_LOGIN": "${DATAFORSEO_LOGIN}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD}"
      }
    },
    "crawl4ai": {
      "type": "sse",
      "url": "http://localhost:11235/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${CRAWL4AI_API_TOKEN}"
      }
    }
  }
}
