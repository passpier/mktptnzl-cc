{
  "enabledMcpjsonServers": ["dataforseo", "crawl4ai"],
  "permissions": {
    "allow": [
      "Bash(uv run scripts/apple.py:*)",
      "Bash(uv run scripts/gplay.py:*)",
      "Bash(uv run scripts/community.py:*)",
      "Bash(uv run scripts/ledger.py:*)",
      "Bash(uv run scripts/snapshot.py:*)",
      "Bash(uv run scripts/econ.py:*)",
      "Bash(uv run hooks/check_report.py:*)",
      "Bash(uv run pytest:*)",
      "mcp__dataforseo__docs_index",
      "mcp__dataforseo__docs_list_sections",
      "mcp__dataforseo__docs_search",
      "mcp__dataforseo__api_request",
      "mcp__crawl4ai__md",
      "mcp__crawl4ai__html",
      "mcp__crawl4ai__crawl",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(cat .env:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__dataforseo__api_request",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" \"$CLAUDE_PROJECT_DIR/hooks/dfs_budget_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__dataforseo__api_request",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" \"$CLAUDE_PROJECT_DIR/hooks/dfs_cost_log.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" \"$CLAUDE_PROJECT_DIR/hooks/check_report.py\""
          }
        ]
      }
    ]
  }
}
